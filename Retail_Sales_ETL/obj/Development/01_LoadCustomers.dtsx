      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{553A488C-6DC2-42E8-BC76-17B0F20CC404}"
          SQLTask:SqlStatementSource="UPDATE ETLAudit &#xA;SET EndTime = GETDATE(),&#xA;    Status = 'Success',&#xA;    RecordsRead = ?,&#xA;    RecordsInserted = ? + ?,&#xA;    RecordsRejected = ?&#xA;WHERE AuditID = ?;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
