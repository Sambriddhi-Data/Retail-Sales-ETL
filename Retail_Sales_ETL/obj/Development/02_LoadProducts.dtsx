          SQLTask:SqlStatementSource="INSERT INTO [dbo].[FileImports]&#xA;           ([FileName]&#xA;           ,[ArchivePath]&#xA;           ,[FileImportStatus])&#xA;     VALUES (?,?,'Received')" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
