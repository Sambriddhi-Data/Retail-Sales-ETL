      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D010717E-6EC1-4C2E-AD87-DF95FF8507CD}"
          SQLTask:SqlStatementSource="UPDATE FileImports SET FileImportStatus = 'Successfully Loaded',&#xA;    ArchivePath = ?, UpdatedDate = GETDATE()&#xA;WHERE FileName = ? AND FileImportStatus IN ('Received','Processing');" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
