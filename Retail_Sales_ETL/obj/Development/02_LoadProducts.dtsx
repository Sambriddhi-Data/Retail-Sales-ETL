      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D010717E-6EC1-4C2E-AD87-DF95FF8507CD}"
          SQLTask:SqlStatementSource="INSERT INTO [dbo].[ETLAudit] ([StartTime],[PackageName],[SourceFile],[Status],[BatchID])&#xA;OUTPUT INSERTED.AuditID values (GETDATE(),?,?,'Running',?);"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="AuditID"
            SQLTask:DtsVariableName="User::AuditID" />
