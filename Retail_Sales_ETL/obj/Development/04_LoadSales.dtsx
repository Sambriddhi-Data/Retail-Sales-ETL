                  SQLTask:SqlStatementSource="INSERT INTO ETLAudit (PackageName, SourceFile, StartTime, EndTime, Status, ErrorMessage, BatchID) &#xA;VALUES (?, ?, GETDATE(), GETDATE(), 'Failed', 'Filename does not match required pattern Sales_YYYYMMDD.csv', ?)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
