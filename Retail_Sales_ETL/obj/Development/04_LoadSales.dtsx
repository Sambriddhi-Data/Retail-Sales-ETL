                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT StgID, SaleID, SaleDate, CustomerID, ProductID, StoreID, Quantity, UnitPrice, SourceFile, BatchID,
       COUNT(*) OVER (PARTITION BY SaleID)                    AS DupCountInFile,
       ROW_NUMBER() OVER (PARTITION BY SaleID ORDER BY StgID) AS RowNumInFile,
       ISDATE(SaleDate)     AS SaleDateIsValid,
       ISNUMERIC(Quantity)  AS QuantityIsNumeric,
       ISNUMERIC(UnitPrice) AS UnitPriceIsNumeric
FROM stg.Sales
WHERE BatchID = ?</property>
