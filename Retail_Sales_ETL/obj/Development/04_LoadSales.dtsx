                  SQLTask:SqlStatementSource="INSERT INTO ETLAudit (PackageName, SourceFile, StartTime, Status, BatchID)&#xA;OUTPUT INSERTED.AuditID&#xA;VALUES (?, ?, GETDATE(), 'Running', ?)"
